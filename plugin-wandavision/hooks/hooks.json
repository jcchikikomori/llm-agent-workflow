{
  "description": "Reminds Claude to route every image through the wandavision MCP server instead of eyeballing it",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash|.*_take_screenshot|.*browse_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/wandavision_hook.py"
          }
        ]
      }
    ]
  }
}
