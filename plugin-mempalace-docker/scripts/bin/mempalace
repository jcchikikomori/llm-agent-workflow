#!/usr/bin/env bash
# Containerized `mempalace` CLI, run inside the shared hub container.
#
# Named exactly `mempalace` (no extension) so the vendored upstream hooks
# find it via `command -v mempalace` once this directory is prepended to
# PATH.
#
# Why `docker exec` into the hub rather than `docker run` a fresh container:
# upstream's hub holds the per-palace writer lease, and a `mine` from any
# other process is refused ("palace ... is held by PID 1"). Inside the hub's
# own container the CLI finds the hub through /data/.mempalace/server/ (same
# PID namespace, same loopback, same token in the environment) and forwards
# the mine over HTTP instead. One writer, no refusals, no container start.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$HERE/lib/common.sh"

# Mines only forward to a *healthy* hub; a direct mine against a booting hub
# would race it. Bounded by MEMPALACE_HUB_WAIT_SECONDS.
"$HERE/hub.sh" ensure --wait >&2 || mp_log "hub not healthy yet; running 'mempalace $*' against it anyway"

# Upstream 3.9.0 bug: a `mine` forwarded to the hub sends `args.mode` as is,
# so a mine without --mode reaches the hub as mode=None and is rejected
# ("invalid mode 'None'"), while a direct mine defaults to `projects`
# (cli.py:888 vs :953 at d5250c7). Supply upstream's own default. The hooks
# always pass --mode, so this only matters for a mine typed by hand.
if [ "${1:-}" = mine ]; then
    has_mode=0
    for arg in "$@"; do
        case "$arg" in
            --mode | --mode=*) has_mode=1; break ;;
        esac
    done
    [ "$has_mode" = 1 ] || set -- "$@" --mode projects
fi

mp_exec_docker exec -i "$MP_HUB_NAME" mempalace "$@"
